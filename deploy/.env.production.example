# Configuration de production — serveur hébergé au Gabon.
# Copier vers backend/.env sur le serveur, puis remplir les secrets.
# Ce fichier ne doit JAMAIS contenir de vraies valeurs dans le dépôt.

APP_NAME=SignalGabon
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.signalement.cnlcei.ga

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Nom de domaine servi par nginx ───────────────────────────────────────────
NOM_DE_DOMAINE=api.signalement.cnlcei.ga

# ── Base de données (MariaDB, conteneur `db`, jamais exposée hors machine) ───
# DB_CONNECTION reste "mysql" : c'est le pilote Laravel utilisé pour MariaDB.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=signalgabon
DB_USERNAME=signalgabon
DB_PASSWORD=
# Utilisé uniquement par le conteneur MariaDB et les sauvegardes.
DB_ROOT_PASSWORD=

# ── Stockage des preuves ─────────────────────────────────────────────────────
# "local" : les fichiers restent sur le serveur, dans le volume `preuves`.
# Ne pas remettre "r2" : Cloudflare R2 est hors du territoire gabonais.
FILESYSTEM_DISK=local

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=sync
CACHE_STORE=file

# ── Notifications email aux citoyens ─────────────────────────────────────────
# Attention : un relais SMTP étranger fait sortir l'email du citoyen du pays.
# Privilégier un relais gabonais, ou laisser MAIL_MAILER=log pour désactiver.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@cnlcei.ga
MAIL_FROM_NAME="SignalGabon"

# ── Front (Vercel) autorisé à appeler cette API ──────────────────────────────
SANCTUM_STATEFUL_DOMAINS=signal-gabon.vercel.app
CORS_ALLOWED_ORIGINS=https://signal-gabon.vercel.app

# ── Sauvegardes ──────────────────────────────────────────────────────────────
# Destinataire GPG des archives chiffrées (empreinte de la clé publique).
SAUVEGARDE_GPG_DESTINATAIRE=
SAUVEGARDE_RETENTION_JOURS=30
